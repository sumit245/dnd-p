# Copy to .env and fill in real values. Never commit .env.

# SMTP (contact form)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your_app_password_here
TO_EMAIL=you@example.com
TO_NAME=Dashandots Technology
FROM_NAME=Dashandots Website

# TinyMCE (admin CMS only)
TINY_MCE_API=your_tinymce_api_key

# MySQL
DB_HOST=127.0.0.1
DB_NAME=dashandots_cms
DB_USER=root
DB_PASS=

# Google Search Console — HTML tag verification (content value only)
GOOGLE_SITE_VERIFICATION=

# Analytics. GTM_CONTAINER_ID must be a GTM-XXXXXXX container id.
# GA4_MEASUREMENT_ID (G-XXXXXXXXXX) loads gtag.js directly so events reach GA4 even
# if the GTM container has no tags. Remove it once a GA4 tag exists in GTM (avoid double counting).
GTM_CONTAINER_ID=GTM-TJ3ZLPNJ
GA4_MEASUREMENT_ID=

# Cookie consent banner (1 = on, 0 = off)
CONSENT_BANNER_ENABLED=1
# Consent Mode default for analytics_storage: denied (opt-in banner) or granted (opt-out)
CONSENT_ANALYTICS_DEFAULT=denied

# Optional pull CDN origin for static assets.
# Example: https://cdn.dashandots.com
ASSET_CDN_URL=

# Public trust/contact details. Leave blank to hide from public templates.
SITE_PUBLIC_EMAIL=hello@dashandots.com
SITE_PHONE=
SITE_WHATSAPP_URL=
SITE_ADDRESS=
SITE_FOUNDER_NAME=
SITE_FOUNDER_TITLE=Founder, Dashandots Technology
SITE_FOUNDER_LINKEDIN=

# Optional analytics and social metadata.
MICROSOFT_CLARITY_ID=
TWITTER_SITE=

# AI project brief (estimate wizard). Provider: deepseek | openai | off
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Optional model override (defaults: deepseek-chat / gpt-4o-mini)
AI_MODEL=
